# API Configuration
VITE_API_URL=http://localhost:5001
VITE_BACKEND_URL=http://localhost:5001

# App Configuration
VITE_APP_NAME=GitHub Clone
VITE_APP_VERSION=1.0.0

# OAuth
VITE_GOOGLE_CLIENT_ID=

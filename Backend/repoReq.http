### create repo
POST http://localhost:5000/repo-api/repos
Content-Type: application/json

{
  "name": "github-clone",
  "description": "backend project",
  "owner": "69b7b75ae2776038a96d2a67"
}

### Get all repos
GET http://localhost:5000/repo-api/repos

### Get repo by id
GET http://localhost:5000/repo-api/repos/69b7cd6d0ffac822fe496890  

### update repo 
PATCH http://localhost:5000/repo-api/repos/69b7cd6d0ffac822fe496890 
Content-Type: application/json  

{
  "description": "updated repo description"
}


### Delete repo
DELETE http://localhost:5000/repo-api/repos/69b7cd6d0ffac822fe496890 


### Add collaborator
POST http://localhost:5000/repo-api/repos/69b7cd6d0ffac822fe496890/collaborators
Content-Type: application/json

{
  "user": "69b7c25500d94be72c2dbf88",
  "role": "collaborator"
}


### get collaborator
GET http://localhost:5000/repo-api/repos/69b7cd6d0ffac822fe496890/collaborators